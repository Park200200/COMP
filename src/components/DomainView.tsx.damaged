                                {isExpanded ? <ChevronDown size={16} /> : <ChevronRight size={16} />}
                              </button>



                              <div className="linked-domain-title-texts">
                                <div className="linked-domain-title-main">
                                  <h3 className="tree-list-path-title">{targetDomain.name} 援ъ꽦 ?곗씠??/h3>
                                  <span className="linked-domain-count-pill">{dData.length}嫄?/span>
                                </div>
                                <span className="tree-list-count-desc">
                                  "{selectedNodeDisplayLabel}" ?몃뱶 ?곌껐 ({targetDomain.anchor === '?대쫫' ? '?몃Ъ 以묒떖' : `${targetDomain.anchor} 以묒떖`}) 쨌 援ъ꽦?붿냼 <strong>{activeFields.length}</strong>媛??ъ슜{unusedCount > 0 ? ` (${unusedCount}媛?誘몄궗???쒖쇅)` : ''} 쨌 ?곗씠??{dData.length}嫄?
                                </span>
                              </div>
                            </div>

                            <div className="linked-domain-header-actions" onClick={e => e.stopPropagation()}>
                              <button
                                type="button"
                                className="domain-header-icon-btn"
                                onClick={() => setFieldConfigModalDomain(targetDomain)}
                                title="?꾨뱶 ?ㅼ젙"
                              >
                                <Settings size={15} />
                              </button>



                              <button
                                type="button"
                                className="domain-header-icon-btn primary"
                                onClick={() => {
                                  if (!isExpanded) {
                                    setExpandedDomainIds(prev => new Set(prev).add(targetDomain.id));
                                  }
                                  setShowLinkedAddFormDomainId(targetDomain.id);
                                                                    setLinkedAddFormData({});
                                }}
                                title={`+ ${targetDomain.name} ???곗씠??異붽?`}
                              >
                                <Plus size={16} />
                              </button>
                            </div>
                          </div>

                          {/* 2. ??댄????쇱낀?????섑??섎뒗 議곗옉 諛붾뵒 */}
                          {isExpanded && (
                            <div className="linked-domain-section-body animate-fade-in">
                              {/* ???곗씠??異붽? ??*/}
                              {isAddingThis && (
                                <div className="crud-form animate-slide-up" style={{ margin: '14px 20px' }}>
                                  <div className="crud-form-header">
                                    <span style={{ display: "inline-flex", alignItems: "center", gap: "6px" }}><Layers size={14} className="tree-linked-icon" /> "{targetDomain.name}" ?꾨찓?몄뿉 ???곗씠??異붽?</span>
                                    <button
                                      className="crud-form-close"
                                      onClick={() => {
                                        setShowLinkedAddFormDomainId(null);

                                      }}
                                    >
                                      <X size={14} />
                                    </button>
                                  </div>

                                  <div className="crud-form-fields">
                                    {activeFields.map((f, fIdx) => {
                                      const bp = blueprints.find(b => b.name === f.name) || f;
                                      const isFullWidth = bp.displayWidth === 'full';
                                      return (
                                        <div key={f.id} className={`crud-form-field ${isFullWidth ? 'width-full' : ''}`}>
                                          <label>{f.name}</label>
                                          {f.inputType === 'tree' ? (
                                            <TreeSelectInput
                                              value={linkedAddFormData[f.name] || ''}
                                              treeData={f.treeData}
                                              onChange={val => setLinkedAddFormData(prev => ({ ...prev, [f.name]: val }))}
                                              placeholder={`${f.name} ?좏깮...`}
                                            />
                                          ) : f.inputType === 'composite' && f.parts && f.parts.length > 0 ? (
                                            <CompositeInput
                                              blueprint={f}
                                              value={linkedAddFormData[f.name] || ''}
                                              onChange={val => setLinkedAddFormData(prev => ({ ...prev, [f.name]: val }))}
                                              existingCompositeValues={fieldExistingValuesMap.get(f.name) || []}
                                              existingPartValuesMap={partExistingValuesMap}
                                              autoFocus={fIdx === 0}
                                            />
                                          ) : f.inputType === 'camera' ? (
                                            <CameraInput
                                              value={linkedAddFormData[f.name] || ''}
                                              onChange={val => setLinkedAddFormData(prev => ({ ...prev, [f.name]: val }))}
                                              fieldName={f.name}
                                              compact
                                              onPreviewClick={url => {
                                                setLightboxImg(url);
                                                setLightboxAnchorId('');
                                                setLightboxFieldKey(f.name);
                                              }}
                                            />
                                          ) : isImageField(f, f.name, linkedAddFormData[f.name]) ? (
                                            <ImageUploadInput
                                              value={linkedAddFormData[f.name] || ''}
                                              onChange={val => setLinkedAddFormData(prev => ({ ...prev, [f.name]: val }))}
                                              fieldName={f.name}
                                              onPreviewClick={url => {
                                                setLightboxImg(url);
                                                setLightboxAnchorId('');
                                                setLightboxFieldKey(f.name);
                                              }}
                                            />
                                          ) : (
                                            <AutocompleteInput
                                              value={linkedAddFormData[f.name] || ''}
                                              onChange={val => setLinkedAddFormData(prev => ({ ...prev, [f.name]: autoFormatByBp(f, val) }))}
                                              placeholder={`${f.name} ?낅젰...`}
                                              fieldName={f.name}
                                              existingValues={fieldExistingValuesMap.get(f.name) || []}
                                              autoFocus={fIdx === 0}
                                            />
                                          )}
                                        </div>
                                      );
                                    })}
                                  </div>

                                  <div className="crud-form-actions">
                                    <button
                                      type="button"
                                      className="crud-save-btn"
                                      onClick={() => {
                                        const payload: Record<string, string> = { ...linkedAddFormData };
                                        if (selectedParentInstanceId) {
                                          payload._parentInstanceId = selectedParentInstanceId;
                                        }
                                        if (selectedNode) {
                                          payload._treeNodeId = selectedNode.id;
                                        }
                                        addEntityToDomain(targetDomain.id, payload);
                                        setLinkedAddFormData({});
                                        setShowLinkedAddFormDomainId(null);
                                      }}
                                    >
                                      ???곗씠???깅줉 ???
                                    </button>
                                    <button
                                      type="button"
                                      className="crud-cancel-btn"
                                      onClick={() => {
                                        setShowLinkedAddFormDomainId(null);
                                      }}
                                    >
                                      痍⑥냼
                                    </button>
                                  </div>
                                </div>
                              )}

                              {/* ?곗씠???뚯씠釉?*/}
                              <div className="tree-list-table-wrap">
                                <table className="crud-table tree-data-table">
                                  <thead>
                                    <tr className="tree-data-table-header-row">
                                      {activeFields.map(f => (
                                        <th
                                          key={f.id}
                                          className="th-sortable"
                                          onClick={() => handleSort(f.name)}
                                          style={{ textAlign: 'left', borderBottom: '2px solid #cbd5e1', padding: '10px 14px' }}
                                        >
                                          <div style={{ display: 'inline-flex', alignItems: 'center', gap: '4px' }}>
                                            <span>{f.name}</span>
                                            {sortField === f.name && (
                                              sortAsc ? <ChevronUp size={12} /> : <ChevronDown size={12} />
                                            )}
                                          </div>
                                        </th>
                                      ))}
                                      <th className="th-actions" style={{ width: '90px', textAlign: 'center', borderBottom: '2px solid #cbd5e1', padding: '10px 14px' }}>愿由?/th>
                                    </tr>
                                  </thead>
                                  <tbody>
                                    {displayData.map(row => {
                                      const isRowEditing = editingRow === row.anchorId;
                                      const isRowDeleting = deleteConfirm === row.anchorId;

                                      const isRowExpanded = expandedLinkedRows.has(row.anchorId);
                                      const hiddenFields = fields.filter(f => {
                                        const cfg = getConstituentFieldConfig(targetDomain.id, f.name, selectedNode?.id);
                                        return cfg.useStatus !== '?? && !f.name.startsWith('_');
                                      });
                                      const hasHiddenFields = hiddenFields.length > 0;

                                      return (
                                        <React.Fragment key={row.anchorId}>
                                        <tr className={`data-row ${isRowEditing ? 'editing' : ''}`}>
                                          {activeFields.map((f, fIdx) => {
                                            const isAnchor = f.name === targetDomain.anchor;

                                            if (isRowEditing) {
                                              return (
                                                <td key={f.id} className="td-editing" onClick={e => e.stopPropagation()}>
                                                  {f.inputType === 'tree' ? (
                                                    <TreeSelectInput
                                                      value={editFormData[f.name] ?? row.data[f.name] ?? ''}
                                                      treeData={f.treeData || masterTreeData}
                                                      onChange={val => setEditFormData(prev => ({ ...prev, [f.name]: val }))}
                                                    />
                                                  ) : f.inputType === 'composite' && f.parts && f.parts.length > 0 ? (
                                                    <CompositeInput
                                                      blueprint={f}
                                                      value={editFormData[f.name] ?? row.data[f.name] ?? ''}
                                                      onChange={val => setEditFormData(prev => ({ ...prev, [f.name]: val }))}
                                                      existingCompositeValues={fieldExistingValuesMap.get(f.name) || []}
                                                      existingPartValuesMap={partExistingValuesMap}
                                                      compact
                                                    />
                                                  ) : isImageField(f, f.name, editFormData[f.name] ?? row.data[f.name]) ? (
                                                    <ImageUploadInput
                                                      value={editFormData[f.name] ?? row.data[f.name] ?? ''}
                                                      onChange={val => setEditFormData(prev => ({ ...prev, [f.name]: val }))}
                                                      fieldName={f.name}
                                                      compact
                                                      onPreviewClick={url => {
                                                        setLightboxImg(url);
                                                        setLightboxAnchorId(row.anchorId);
                                                        setLightboxFieldKey(f.name);
                                                      }}
                                                    />
                                                  ) : (
                                                    <AutocompleteInput
                                                      className="crud-inline-input"
                                                      value={editFormData[f.name] ?? row.data[f.name] ?? ''}
                                                      onChange={val => setEditFormData(prev => ({ ...prev, [f.name]: autoFormatByBp(f, val) }))}
                                                      fieldName={f.name}
                                                      existingValues={fieldExistingValuesMap.get(f.name) || []}
                                                      autoFocus={fIdx === 0}
                                                    />
                                                  )}
                                                </td>
                                              );
                                            }

                                            // 酉?紐⑤뱶 - ?대?吏 ?꾨뱶 ?곗꽑 泥댄겕
                                            return (
                                              <td key={f.id} className={`td-value ${isAnchor ? 'td-anchor' : ''}`}>
                                                {isImageField(f, f.name, row.data[f.name]) && row.data[f.name] ? (
                                                  <img
                                                    src={row.data[f.name]}
                                                    alt={f.name}
                                                    style={{ width: '32px', height: '32px', objectFit: 'cover', borderRadius: '4px', verticalAlign: 'middle', cursor: 'pointer', border: '1px solid #cbd5e1' }}
                                                    onClick={(e) => {
                                                      e.stopPropagation();
                                                      setLightboxImg(row.data[f.name]);
                                                      setLightboxAnchorId(row.anchorId);
                                                      setLightboxFieldKey(f.name);
                                                    }}
                                                    title="?대┃?섏뿬 ?먮낯 蹂닿린"
                                                  />
                                                ) : isAnchor ? (
                                                  <span className="anchor-text">
                                                    {autoFormatByBp(f, row.data[f.name] || '') || '-'}
                                                  </span>
                                                ) : (
                                                  <span>{autoFormatByBp(f, row.data[f.name] || '') || '-'}</span>
                                                )}
                                              </td>
                                            );
                                          })}

                                          {/* 愿由??≪뀡 */}
                                          <td className="td-actions" onClick={e => e.stopPropagation()}>
                                            {hasHiddenFields && !isRowDeleting && (
                                              <button
                                                className="action-btn"
                                                title={isRowExpanded ? "?④? ?꾨뱶 ?묎린" : `?④? ?꾨뱶 ${hiddenFields.length}媛??쇱튂湲?}
                                                onClick={() => handleToggleExpandLinkedRow(row.anchorId)}
                                                style={{ color: isRowExpanded ? '#6366f1' : '#94a3b8' }}
                                              >
                                                {isRowExpanded ? <ChevronUp size={14} /> : <ChevronDown size={14} />}
                                              </button>
                                            )}
                                            {isRowDeleting ? (
                                              <div className="delete-confirm">
                                                <span>??젣?</span>
                                                <button className="action-btn confirm-yes" title="??젣 ?뺤젙" onClick={() => {
                                                  removeEntityFromDomain(targetDomain.id, row.anchorId);
                                                  setDeleteConfirm(null);
                                                  setEditingRow(null);
                                                  setEditFormData({});
                                                }}>??/button>
                                                <button className="action-btn confirm-no" title="??젣 痍⑥냼" onClick={() => setDeleteConfirm(null)}>痍⑥냼</button>
                                              </div>
                                            ) : isRowEditing ? (
                                              <>
                                                <button className="action-btn cancel" title="痍⑥냼" onClick={() => { setEditingRow(null); setEditFormData({}); }}>
                                                  <X size={14} />
                                                </button>
                                                <button
                                                  className="action-btn save"
                                                  title="???
                                                  onClick={() => {
                                                    Object.entries(editFormData).forEach(([fieldType, newValue]) => {
                                                      if (newValue !== row.data[fieldType]) {
                                                        updateEntityField(row.anchorId, fieldType, newValue);
                                                      }
                                                    });
                                                    setEditingRow(null);
                                                    setEditFormData({});
                                                  }}>
                                                  <Save size={14} />
                                                </button>
                                                <button
                                                  className="action-btn delete"
                                                  title={`${targetDomain.name}?먯꽌 ??젣`}
                                                  onClick={() => setDeleteConfirm(row.anchorId)}
                                                >
                                                  <Trash2 size={14} />
                                                </button>
                                              </>
                                            ) : (
                                              <button
                                                className="action-btn settings"
                                                title="?섏젙"
                                                onClick={() => {
                                                  setEditingRow(row.anchorId);
                                                  setEditFormData({ ...row.data });
                                                }}
                                              >
                                                <Settings size={15} />
                                              </button>
                                            )}
                                          </td>
                                        </tr>
                                        {(isRowExpanded || isRowEditing) && hasHiddenFields && (
                                          <tr className="data-row hidden-fields-row">
                                            <td colSpan={activeFields.length + 1} style={{ padding: '8px 14px', background: '#f8fafc' }}>
                                              <div style={{ display: 'flex', flexWrap: 'wrap', gap: '12px 24px' }}>
                                                {hiddenFields.map(hf => (
                                                  <div key={hf.id} style={{ display: 'flex', alignItems: 'center', gap: '6px', fontSize: '13px', minWidth: '180px' }}>
                                                    <span style={{ color: '#64748b', fontWeight: 500, whiteSpace: 'nowrap' }}>{hf.name}:</span>
                                                    {isRowEditing ? (
                                                      isImageField(hf, hf.name, editFormData[hf.name] ?? row.data[hf.name]) ? (
                                                        <ImageUploadInput
                                                          value={editFormData[hf.name] ?? row.data[hf.name] ?? ''}
                                                          onChange={val => setEditFormData(prev => ({ ...prev, [hf.name]: val }))}
                                                          fieldName={hf.name}
                                                          compact
                                                          onPreviewClick={url => {
                                                            setLightboxImg(url);
                                                            setLightboxAnchorId(row.anchorId);
                                                            setLightboxFieldKey(hf.name);
                                                          }}
                                                        />
                                                      ) : (
                                                        <input
                                                          type={hf.inputType === 'number' ? 'number' : 'text'}
                                                          className="crud-inline-input"
                                                          value={editFormData[hf.name] ?? row.data[hf.name] ?? ''}
                                                          onChange={e => setEditFormData(prev => ({ ...prev, [hf.name]: e.target.value }))}
                                                          placeholder={`${hf.name} ?낅젰...`}
                                                          style={{ flex: 1, minWidth: '100px', padding: '4px 8px', border: '1px solid #cbd5e1', borderRadius: '4px', fontSize: '13px' }}
                                                        />
                                                      )
                                                    ) : (
                                                      isImageField(hf, hf.name, row.data[hf.name]) && row.data[hf.name] ? (
                                                        <img src={row.data[hf.name]} alt={hf.name} style={{ width: '28px', height: '28px', objectFit: 'cover', borderRadius: '4px', border: '1px solid #cbd5e1', cursor: 'pointer' }} onClick={() => { setLightboxImg(row.data[hf.name]); setLightboxAnchorId(row.anchorId); setLightboxFieldKey(hf.name); }} />
                                                      ) : (
                                                        <span style={{ color: '#334155' }}>{row.data[hf.name] || '-'}</span>
                                                      )
                                                    )}
                                                  </div>
                                                ))}
                                              </div>
                                            </td>
                                          </tr>
                                        )}
                                      </React.Fragment>);
                                    })}

                                    {activeFields.length > 0 && displayData.length === 0 && (
                                      <tr>
                                        <td colSpan={activeFields.length + 1} className="td-empty">
                                          <div className="tree-empty-list-notice">
                                            <span>
                                              ?뱥 "{targetDomain.name}" ?꾨찓?몄뿉 ?깅줉???곗씠?곌? ?놁뒿?덈떎.
                                            </span>
                                            <button
                                              type="button"
                                              className="tree-add-data-inline-btn"
                                              onClick={() => {
                                                setShowLinkedAddFormDomainId(targetDomain.id);
                                                setLinkedAddFormData({});
                                              }}
                                            >
                                              + 吏湲?"{targetDomain.name}" ?곗씠??異붽?
                                            </button>
                                          </div>
                                        </td>
                                      </tr>
                                    )}
                                  </tbody>
                                </table>
                              </div>
                            </div>
                          )}
                        </div>
                      );
                    })}
                  </div>
                ) : (
                  /* ===== ?곌껐???꾨찓?몄씠 ?녿뒗 ?쇰컲 ?몃뱶: 湲곗〈 ?몃━ 遺꾨쪟 ?곗씠?곕━?ㅽ듃 ===== */
                  <>
                    <div className="tree-list-header">
                      <div className="tree-list-title-wrap">
                        <span className="tree-list-path-icon">?뱚</span>
                        <div>
                          <h3 className="tree-list-path-title">
                            {selectedNodePath === '?꾩껜'
                              ? '?꾩껜 ?곗씠??由ъ뒪??
                              : selectedNodePath === '(誘몃텇瑜?'
                                ? '誘몃텇瑜??곗씠??由ъ뒪??
                                : `${selectedNodePath} 遺꾨쪟 ?곗씠??}
                          </h3>
                          <span className="tree-list-count-desc">
                            ?곌껐???곗씠??珥?strong>{rightListData.length}</strong>嫄?                         </span>
                        </div>
                      </div>

                      {selectedLinkedDomains.length > 0 && (
<button
                        type="button"
                        className="crud-add-btn tree-add-data-btn"
                        onClick={() => {
                          setShowAddForm(true);
                          const defaultPath = selectedNodePath === '?꾩껜' || selectedNodePath === '(誘몃텇瑜?' ? '' : selectedNodePath;
                          setAddFormData(treeField ? { [treeField.name]: defaultPath } : {});
                        }}
                      >
                        <Plus size={14} /> ?뱥 遺꾨쪟?????곗씠??異붽?
                      </button>
                      )}
                    </div>

                    {/* ?곌껐 ?곗씠?고뀒?대툝由ъ뒪??/}
                    <div className="tree-table-container">
                      <table className="domain-table">
                        <thead>
                          <tr>
                            {fields.map(f => (
                              <th key={f.id} onClick={() => handleSort(f.name)} className="sortable">
                                {f.name}
                                {sortField === f.name && (
                                  sortAsc ? <ChevronUp size={12} /> : <ChevronDown size={12} />
                                )}
                              </th>
                            ))}
                            {treeField && !fields.some(f => f.name === treeField.name) && (
                              <th>遺꾨쪟 寃쎈줈</th>
                            )}
                            <th className="th-actions">愿由?/th>
                          </tr>
                        </thead>
                        <tbody>
                          {rightListData.map(row => {
                            const isEditing = editingRow === row.anchorId;
                            const isDeleting = deleteConfirm === row.anchorId;

                            return (
                              <tr
                                key={row.anchorId}
                                className={`${isEditing ? 'editing' : ''} ${isDeleting ? 'deleting' : ''}`}
                              >
                                {fields.map(f => {
                                  const isNameField = f.name === '?대쫫';
                                  const profileImg = isNameField ? getProfileImage(row.data) : null;

                                  return (
                                    <td key={f.id} className={isNameField ? 'td-name' : ''}>
                                      {isEditing ? (
                                        f.inputType === 'tree' ? (
                                          <div onClick={e => e.stopPropagation()}>
                                            <TreeSelectInput
                                              value={editFormData[f.name] ?? row.data[f.name] ?? ''}
                                              treeData={f.treeData || masterTreeData}
                                              onChange={val => setEditFormData(prev => ({ ...prev, [f.name]: val }))}
                                            />
                                          </div>
                                        ) : f.inputType === 'composite' && f.parts && f.parts.length > 0 ? (
                                          <div onClick={e => e.stopPropagation()}>
                                            <CompositeInput
                                              blueprint={f}
                                              value={editFormData[f.name] ?? row.data[f.name] ?? ''}
                                              onChange={val => setEditFormData(prev => ({ ...prev, [f.name]: val }))}
                                              existingCompositeValues={fieldExistingValuesMap.get(f.name) || []}
                                              existingPartValuesMap={partExistingValuesMap}
                                              compact
                                            />
                                          </div>
                                        ) : isImageField(f, f.name, editFormData[f.name] ?? row.data[f.name]) ? (
                                          <div onClick={e => e.stopPropagation()}>
                                            <ImageUploadInput
                                              value={editFormData[f.name] ?? row.data[f.name] ?? ''}
                                              onChange={val => setEditFormData(prev => ({ ...prev, [f.name]: val }))}
                                              fieldName={f.name}
                                              compact
                                              onPreviewClick={url => {
                                                setLightboxImg(url);
                                                setLightboxAnchorId(row.anchorId);
                                                setLightboxFieldKey(f.name);
                                              }}
                                            />
                                          </div>
                                        ) : (
                                          <div onClick={e => e.stopPropagation()}>
                                            <AutocompleteInput
                                              className="crud-inline-input"
                                              value={editFormData[f.name] ?? row.data[f.name] ?? ''}
                                              onChange={val => setEditFormData(prev => ({ ...prev, [f.name]: autoFormatByBp(f, val) }))}
                                              fieldName={f.name}
                                              existingValues={fieldExistingValuesMap.get(f.name) || []}
                                            />
                                          </div>
                                        )
                                      ) : isNameField ? (
                                        <div className="profile-cell-wrapper" style={{ display: 'inline-flex', alignItems: 'center', gap: '10px' }}>
                                          <div
                                            className="profile-avatar-container"
                                            style={{
                                              position: 'relative',
                                              width: '32px',
                                              height: '32px',
                                              borderRadius: '50%',
                                              flexShrink: 0,
                                              overflow: 'hidden',
                                            }}
                                          >
                                            {profileImg ? (
                                              <img src={profileImg.url} alt="?꾨줈?? style={{ width: '100%', height: '100%', objectFit: 'cover' }} />
                                            ) : (
                                              <span style={{ display: 'flex', alignItems: 'center', justifyContent: 'center', width: '100%', height: '100%', fontSize: '14px', color: '#94a3b8' }}>+</span>
                                            )}
                                            <input
                                              id={`avatar-file-${row.anchorId}`}
                                              type="file"
                                              accept="image/*"
                                              style={{ display: 'none' }}
                                              onChange={async (e) => {
                                                const file = e.target.files?.[0];
                                                if (file) {
                                                  const compressed = await compressImageFile(file);
                                                  try {
                                                    const localPath = await uploadImageToLocal(compressed);
                                                    updateEntityField(row.anchorId, '사진', localPath);
                                                  } catch {
                                                    updateEntityField(row.anchorId, '사진', compressed);
                                                  }
                                                }
                                              }}
                                            />
                                          </div>
                                          <span className="profile-name-text">
                                            {autoFormatByBp(f, row.data[f.name] || '') || '-'}
                                          </span>
                                        </div>
                                      ) : f.inputType === 'tree' && row.data[f.name] ? (
                                        <span className="tree-path-display">
                                          {row.data[f.name].split(' > ').map((seg: string, i: number, arr: string[]) => (
                                            <React.Fragment key={i}>
                                              <span className="tree-path-segment">{seg}</span>
                                              {i < arr.length - 1 && <ChevronRight size={10} className="tree-path-sep" />}
                                            </React.Fragment>
                                          ))}
                                        </span>
                                      ) : isImageField(f, f.name, row.data[f.name]) && row.data[f.name] ? (
                                        <img
                                          src={row.data[f.name]}
                                          alt={f.name}
                                          style={{ width: '32px', height: '32px', objectFit: 'cover', borderRadius: '4px', verticalAlign: 'middle', cursor: 'pointer', border: '1px solid #cbd5e1' }}
                                          onClick={(e) => {
                                            e.stopPropagation();
                                            setLightboxImg(row.data[f.name]);
                                            setLightboxAnchorId(row.anchorId);
                                            setLightboxFieldKey(f.name);
                                          }}
                                          title="?대┃?섏뿬 ?먮낯 蹂닿린"
                                        />
                                      ) : (
                                        autoFormatByBp(f, row.data[f.name] || '') || '-'
                                      )}
                                    </td>
                                  );
                                })}

                                {/* 遺꾨쪟 寃쎈줈 而щ읆 (?꾨찓?퇰ields???몃━ ?꾨뱶媛 吏곸젒 ?쒖떆?섏? ?딅뒗 寃쎌슦?먮룄 ?쒖떆) */}
                                {treeField && !fields.some(f => f.name === treeField.name) && (
                                  <td>
                                    {isEditing ? (
                                      <div onClick={e => e.stopPropagation()}>
                                        <TreeSelectInput
                                          value={editFormData[treeField.name] ?? row.data[treeField.name] ?? ''}
                                          treeData={treeField.treeData || masterTreeData}
                                          onChange={val => setEditFormData(prev => ({ ...prev, [treeField.name]: val }))}
                                        />
                                      </div>
                                    ) : row.data[treeField.name] ? (
                                      <span className="tree-path-display">
                                        {row.data[treeField.name].split(' > ').map((seg: string, i: number, arr: string[]) => (
                                          <React.Fragment key={i}>
                                            <span className="tree-path-segment">{seg}</span>
                                            {i < arr.length - 1 && <ChevronRight size={10} className="tree-path-sep" />}
                                          </React.Fragment>
                                        ))}
                                      </span>
                                    ) : (
                                      <span style={{ color: '#94a3b8', fontSize: '0.75rem' }}>(誘몃텇瑜?</span>
                                    )}
                                  </td>
                                )}

                                {/* 愿由??≪뀡 */}
                                <td className="td-actions" onClick={e => e.stopPropagation()}>
                                  {isDeleting ? (
                                    <div className="delete-confirm">
                                      <span>??젣?</span>
                                      <button className="action-btn confirm-yes" title="??젣 ?뺤젙" onClick={() => {
                                        if (activeDomain) removeEntityFromDomain(activeDomain.id, row.anchorId);
                                        setDeleteConfirm(null);
                                        setEditingRow(null);
                                        setEditFormData({});
                                      }}></button>
                                      <button className="action-btn confirm-no" title="??젣 痍⑥냼" onClick={() => setDeleteConfirm(null)}>痍⑥냼</button>
                                    </div>
                                  ) : isEditing ? (
                                    <>
                                      <button className="action-btn cancel" title="痍⑥냼" onClick={() => { setEditingRow(null); setEditFormData({}); }}>
                                        <X size={14} />
                                      </button>
                                      <button
                                        className="action-btn save"
                                        title="???
                                        onClick={() => {
                                          Object.entries(editFormData).forEach(([fieldType, newValue]) => {
                                            if (newValue !== row.data[fieldType]) {
                                              updateEntityField(row.anchorId, fieldType, newValue);
                                            }
                                          });
                                          setEditingRow(null);
                                          setEditFormData({});
                                        }}>
                                          <Save size={14} />
                                        </button>
                                        <button
                                          className="action-btn delete"
                                          title={`${activeDomain?.name || '?꾨찓??}?먯꽌 ??젣`}
                                        onClick={() => setDeleteConfirm(row.anchorId)}
                                      >
                                        <Trash2 size={14} />
                                      </button>
                                    </>
                                  ) : (
                                    <>
                                      {activeDomain && !isAllMode && (
                                        <button
                                          className="action-btn settings"
                                          title="???
                                          onClick={() => {
                                            setEditingRow(row.anchorId);
                                            setEditFormData({ ...row.data });
                                          }}
                                        >
                                          <Settings size={15} />
                                        </button>
                                      )}
                                    </>
                                  )}
                                </td>
                              </tr>
                            );
                          })}

                          {rightListData.length === 0 && selectedLinkedDomains.length > 0 && (
                            <tr>
                              <td colSpan={fields.length + 2} className="td-empty">
                                <div className="tree-empty-list-notice">
                  <span>?뱥 "{selectedNodePath}" 遺꾨쪟???곌껐???곗씠?곌? ?놁뒿?덈떎.</span>
                                  <button
                                    type="button"
                                    className="tree-add-data-inline-btn"
                                    onClick={() => {
                                      setShowAddForm(true);
                                      const defaultPath = selectedNodePath === '?꾩껜' || selectedNodePath === '(誘몃텇瑜?' ? '' : selectedNodePath;
                                      setAddFormData(treeField ? { [treeField.name]: defaultPath } : {});
                                    }}
                                  >
                    + 吏湲???遺꾨쪟?????곗씠??異붽?
                                  </button>
                                </div>
                              </td>
                            </tr>
                          )}
                        </tbody>
                      </table>
                    </div>
                  </>
                )}
              </div>
            </div>
          )}
        </div>
      )}

      {/* ??젣 ?덈궡 ?좎뒪??*/}
      {deleteConfirm && activeDomain && (
        <div className="delete-toast">
          二쇱쓽: "{activeDomain.name}"?먯꽌留???젣?⑸땲?? ?ㅻⅨ ?꾨찓?몄쓽 ?곗씠?곕뒗 ?곹뼢 ?놁뒿?덈떎.
        </div>
      )}

      {/* ?꾨줈??사진 ?먮낯 ?뺣낫 & 愿由?紐⑤떖 (Lightbox) */}
      {lightboxImg && (
        <div
          className="avatar-lightbox-backdrop"
          style={{
            position: 'fixed',
            inset: 0,
            background: 'rgba(0, 0, 0, 0.75)',
            display: 'flex',
            alignItems: 'center',
            justifyContent: 'center',
            zIndex: 9999
          }}
          onClick={() => setLightboxImg(null)}
        >
          <div
            style={{
              background: '#fff',
              borderRadius: '12px',
              padding: '20px',
              maxWidth: '90vw',
              maxHeight: '90vh',
              display: 'flex',
              flexDirection: 'column',
              alignItems: 'center',
              gap: '14px',
              boxShadow: '0 20px 40px rgba(0,0,0,0.3)'
            }}
            onClick={(e) => e.stopPropagation()}
          >
            <div style={{ display: 'flex', justifyContent: 'space-between', width: '100%', alignItems: 'center' }}>
              <span style={{ fontWeight: 700, fontSize: '0.95rem', color: '#1e293b' }}>?꾨줈??사진</span>
              <button
                onClick={() => setLightboxImg(null)}
                style={{ background: 'transparent', border: 'none', cursor: 'pointer', color: '#64748b' }}
              >
                <X size={18} />
              </button>
            </div>
            <img
              src={lightboxImg}
              alt=""
              style={{ maxWidth: '360px', maxHeight: '360px', objectFit: 'contain', borderRadius: '8px', border: '1px solid #e2e8f0' }}
            />
            <div style={{ display: 'flex', gap: '8px', width: '100%', justifyContent: 'flex-end' }}>
              <label style={{
                background: '#4f46e5',
                color: '#fff',
                padding: '6px 14px',
                borderRadius: '6px',
                fontSize: '0.82rem',
                cursor: 'pointer',
                display: 'inline-flex',
                alignItems: 'center',
                gap: '4px'
              }}>
                <Camera size={14} />
                <span>사진 蹂寃?/span>
                <input
                  type="file"
                  accept="image/*"
                  style={{ display: 'none' }}
                  onChange={async (e) => {
                    const file = e.target.files?.[0];
                    if (file && lightboxAnchorId) {
                      const compressed = await compressImageFile(file);
                      try {
                        const localPath = await uploadImageToLocal(compressed);
                        updateEntityField(lightboxAnchorId, lightboxFieldKey || '사진', localPath);
                        setLightboxImg(localPath);
                      } catch {
                        updateEntityField(lightboxAnchorId, lightboxFieldKey || '사진', compressed);
                        setLightboxImg(compressed);
                      }
                    }
                  }}
                />
              </label>
              <button
                style={{
                  background: '#fee2e2',
                  color: '#dc2626',
                  border: '1px solid #fecaca',
                  padding: '6px 14px',
                  borderRadius: '6px',
                  fontSize: '0.82rem',
                  cursor: 'pointer',
                  display: 'inline-flex',
                  alignItems: 'center',
                  gap: '4px'
                }}
                onClick={() => {
                  if (lightboxAnchorId) {
                    updateEntityField(lightboxAnchorId, lightboxFieldKey || '사진', '');
                    setLightboxImg(null);
                  }
                }}
              >
                <Trash2 size={14} />
                <span>사진 ??젣</span>
              </button>
            </div>
          </div>
        </div>
      )}

      {/* 1. ?몃━ ?몃뱶 而⑦뀓?ㅽ듃 硫붾돱 (?고겢由??먮뒗 鍮좊Ⅸ 踰꾪듉 ?대┃ ?? */}
      {nodeContextMenu && typeof document !== 'undefined' && createPortal(
        <div
          className="tree-node-context-menu animate-scale-in"
          style={{
            position: 'fixed',
            top: `${nodeContextMenu.y}px`,
            left: `${nodeContextMenu.x}px`,
            zIndex: 999999,
          }}
          onClick={e => e.stopPropagation()}
        >
          <div className="tree-menu-header">
            <span>鍮좊Ⅸ 遺꾨쪟 ?몃뱶 愿由?/span>
            <button type="button" className="tree-menu-close" onClick={() => setNodeContextMenu(null)}>??/button>
          </div>
          <div className="tree-menu-items">
            <button
              type="button"
              className="tree-menu-item"
              onClick={() => {
                setAddingChildParentId(nodeContextMenu.nodeId);
                setNewChildLabel('');
                setNodeContextMenu(null);
              }}
            >
              <Plus size={13} />
              <span>?섏쐞 遺꾨쪟 異붽?</span>
            </button>

            <button
              type="button"
              className="tree-menu-item highlight"
              onClick={() => {
                const target = masterTreeData ? findNodeById(masterTreeData, nodeContextMenu.nodeId) : null;
                if (target) handleOpenPropsModal(target);
              }}
            >
              <Sliders size={13} />
              <span>?몃뱶 ?띿꽦 愿由??곸꽭)</span>
            </button>

            <button
              type="button"
              className="tree-menu-item"
              onClick={() => {
                setLinkingNodeId(nodeContextMenu.nodeId);
                setLinkingInstanceId(null);
                setNodeContextMenu(null);
              }}
            >
              <Link2 size={13} />
              <span>?꾨찓???곌껐</span>
            </button>

            <div className="tree-menu-divider" />

            <button
              type="button"
              className="tree-menu-item"
              onClick={() => handleMoveNode(nodeContextMenu.nodeId, 'up')}
            >
              <ArrowUp size={13} />
              <span>?꾨줈 ?대룞</span>
            </button>

            <button
              type="button"
              className="tree-menu-item"
              onClick={() => handleMoveNode(nodeContextMenu.nodeId, 'down')}
            >
              <ArrowDown size={13} />
              <span>?꾨옒濡??대룞</span>
            </button>

            <div className="tree-menu-divider" />

            <button
              type="button"
              className="tree-menu-item delete"
              onClick={() => {
                const target = masterTreeData ? findNodeById(masterTreeData, nodeContextMenu.nodeId) : null;
                if (target) handleDeleteNode(target.id, target.label);
                setNodeContextMenu(null);
              }}
            >
              <Trash2 size={13} />
              <span>?몃뱶 ??젣</span>
            </button>
          </div>
        </div>,
        document.body
      )}

      {/* 2. ?몃━ ?몃뱶 ?띿꽦 愿由?紐⑤떖 */}
      {propsModalNode && typeof document !== 'undefined' && createPortal(
        <div className="tree-props-modal-overlay animate-fade-in" onClick={e => e.stopPropagation()}>
          <div className="tree-props-modal-content animate-scale-in" onClick={e => e.stopPropagation()}>
            <div className="tree-props-modal-header">
              <div className="tree-props-modal-title">
                <Settings size={16} />
                <span>?몃━ ?몃뱶 ?띿꽦 愿由?/span>
              </div>
              <button type="button" className="tree-props-modal-close" onClick={() => setPropsModalNode(null)}>??/button>
            </div>

            <div className="tree-props-modal-body">
              {/* 遺꾨쪟紐?*/}
              <div className="tree-props-form-group">
                <label>遺꾨쪟 ?대쫫 <span className="required">*</span></label>
                <input
                  type="text"
                  className="tree-props-input"
                  value={nodePropsForm.label}
                  onChange={e => setNodePropsForm(prev => ({ ...prev, label: e.target.value }))}
                   placeholder="遺꾨쪟 ?대쫫???낅젰?섏꽭??
                 />
               </div>

               <div className="tree-props-form-group">
              <label>遺꾨쪟 ?앸퀎 肄붾뱶 (?좏깮)</label>
                <input
                  type="text"
                  className="tree-props-input"
                  value={nodePropsForm.code}
                   placeholder="?? HIST-01, ARC-1950 ??
                />
              <span className="tree-props-guide">遺꾨쪟 ?몃━?먯꽌 ?몃뱶 ?놁뿉 肄붾뱶濡??쒓린 ?쒖떆?⑸땲??</span>
              </div>

              {/* ????꾩씠肄??좏깮 */}
              <div className="tree-props-form-group">
              <label>?몃뱶 ????꾩씠肄?/label>
                <div className="tree-props-icon-palette">
                {['?뱚', '?뱥', '?벛', '?뱛', '?뾺截?, '?뱞', '?벐', '?뱫', '?뿋截?, '?뱦', '?뱨', '?뵔', '?뤇截?, '?뾻截?, '?벀'].map(ic => (
                    <button
                      key={ic}
                      type="button"
                      className={`tree-props-icon-btn ${nodePropsForm.icon === ic ? 'selected' : ''}`}
                      onClick={() => setNodePropsForm(prev => ({ ...prev, icon: ic }))}
                    >
                      {ic}
                    </button>
                  ))}
                </div>
              </div>

              {/* ?곌껐 ?꾨찓???좏깮 (蹂듭닔 ?좏깮 媛?? */}
              <div className="tree-props-form-group">
                <label>?곌껐 ?꾨찓??(蹂듭닔 ?좏깮 媛??</label>
                <div className="tree-props-domain-checkbox-list">
                  {domains.map(dom => {
                    const isChecked = nodePropsForm.linkedDomainIds.includes(dom.id);
                    return (
                      <label key={dom.id} className="tree-props-domain-checkbox-item">
                        <input
                          type="checkbox"
                          checked={isChecked}
                          onChange={(e) => {
                            if (e.target.checked) {
                              setNodePropsForm(prev => ({
                                ...prev,
                                linkedDomainIds: [...prev.linkedDomainIds, dom.id]
                              }));
                            } else {
                              setNodePropsForm(prev => ({
                                ...prev,
                                linkedDomainIds: prev.linkedDomainIds.filter(id => id !== dom.id)
                              }));
                            }
                          }}
                        />
                        <span className="item-name">{dom.name}</span>
                        <span className="item-count">({dom.fields.length}媛??꾨뱶)</span>
                      </label>
                    );
                  })}
                </div>
                <span className="tree-props-guide">?좏깮???꾨찓?몃뱾???곗씠?곕? ???몃뱶?먯꽌 ?④퍡 愿由ы븯怨??꾪솚?????덉뒿?덈떎.</span>
              </div>

              {/* ?ㅻ챸 諛?硫붾え */}
              <div className="tree-props-form-group">
                <label>遺꾨쪟 ?ㅻ챸 / ?섏쭛 湲곗? 硫붾え</label>
                <textarea
                  className="tree-props-textarea"
                  rows={3}
                  value={nodePropsForm.description}
                  onChange={e => setNodePropsForm(prev => ({ ...prev, description: e.target.value }))}
                  placeholder=""
                />
              </div>
            </div>

            <div className="tree-props-modal-footer">
              <button type="button" className="tree-props-btn cancel" onClick={() => setPropsModalNode(null)}>
                痍⑥냼
              </button>
              <button type="button" className="tree-props-btn save" onClick={handleSaveNodeProps}>
                ?띿꽦 ???
              </button>
            </div>
          </div>
        </div>,
        document.body
      )}
    </div>
  );
};
