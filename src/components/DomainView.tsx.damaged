                                        <div className="field-info-wrap">
                                          <span className="field-name-main">{f.name}</span>
                                          <span className="field-type-pill">{f.inputType}</span>
                                          {isUnused && <span className="field-badge-unused">?붾㈃ ?쒖쇅(遺)</span>}
                                        </div>
                                      </td>
                                      <td style={{ textAlign: 'center' }}>
                                        <button
                                          type="button"
                                          className={`btn-field-status use-${cfg.useStatus === '?? ? 'y' : 'n'}`}
                                          style={{ padding: '6px 14px', fontSize: '12px' }}
                                          onClick={() => handleUpdateConstituentFieldStatus(
                                            fieldConfigModalDomain.id,
                                            f.name,
                                            { useStatus: cfg.useStatus === '?? ? '遺' : '?? },
                                            selectedNode?.id
                                          )}
                                          title={`?ъ슜?곹깭: ${cfg.useStatus} (?대┃?섏뿬 ?꾪솚, '遺'硫??붾㈃???쒖떆?섏? ?딆쓬)`}
                                        >
                                          {cfg.useStatus === '?? ? '???ъ슜' : '??誘몄궗??遺)'}
                                        </button>
                                      </td>
                                    </tr>
                                  );
                                })}
                              </tbody>
                            </table>
                          </div>

                          <div className="field-config-modal-footer">
                            <span className="field-config-modal-hint">
                              <strong>'?ъ슜'</strong>?쇰줈 ?ㅼ젙??援ъ꽦?붿냼???뚯씠釉?酉곗쓽 而щ읆?쇰줈 ?쒖떆?섎ŉ, <strong>'誘몄궗??</strong>?쇰줈 ?ㅼ젙??援ъ꽦?붿냼???붾㈃?먯꽌 ?쒖쇅?⑸땲??
                            </span>
                            <button
                              type="button"
                              className="crud-save-btn"
                              onClick={() => setFieldConfigModalDomain(null)}
                            >
                              ?뺤씤 ?꾨즺
                            </button>
                          </div>
                        </div>
                      </div>
                    )}

                    {/* 媛??곌껐 ?꾨찓?몃퀎 ??댄? 移대뱶 諛??쇱묠 議곗옉 ?붾㈃ */}
                    {selectedLinkedDomains.map(targetDomain => {
                      const isExpanded = expandedDomainIds.has(targetDomain.id);
                      // ?꾨찓?몃퀎 ?곗씠??諛??꾨뱶 怨꾩궛
                      const allData = getAtomsForDomain(targetDomain.id);
                      const dData = allData.filter(row => {
                        if (selectedParentInstanceId && row.data._parentInstanceId && row.data._parentInstanceId !== selectedParentInstanceId) return false;
                        if (selectedNode && row.data._treeNodeId) return row.data._treeNodeId === selectedNode.id;
                        return true;
                      });

                      const fields = getFieldsForDomain(targetDomain.id).filter(f => !compositePartNames.has(f.name));
                      const activeFields = fields.filter(f => {
                        const cfg = getConstituentFieldConfig(targetDomain.id, f.name, selectedNode?.id);
                        return cfg.useStatus === '??;
                      });
                      const unusedCount = fields.length - activeFields.length;

                      // ?뺣젹 諛?寃???꾪꽣留?
                      let displayData = [...dData];
                      if (quickSearch.trim()) {
                        const q = quickSearch.trim().toLowerCase();
                        displayData = displayData.filter(r =>
                          Object.values(r.data).some(v => v && String(v).toLowerCase().includes(q))
                        );
                      }
                      if (sortField) {
                        displayData.sort((a, b) => {
                          const va = a.data[sortField] || '';
                          const vb = b.data[sortField] || '';
                          return sortAsc ? va.localeCompare(vb, 'ko') : vb.localeCompare(va, 'ko');
                        });
                      }

                      const isAddingThis = showLinkedAddFormDomainId === targetDomain.id;

                      return (
                        <div
                          key={targetDomain.id}
                          className={`linked-domain-section-card ${isExpanded ? 'expanded' : 'collapsed'}`}
                        >
                          {/* 1. ?꾨찓????댄? ?ㅻ뜑 */}
                          <div
                            className="linked-domain-section-header"
                            onClick={() => toggleDomainExpanded(targetDomain.id)}
                          >
                            <div className="linked-domain-title-left">
                              <button
                                type="button"
                                className="linked-domain-collapse-btn"
                                onClick={(e) => {
                                  e.stopPropagation();
                                  toggleDomainExpanded(targetDomain.id);
                                }}
                                title={isExpanded ? '?묎린' : '?쇱튂湲?}
