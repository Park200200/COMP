                  >
                    <span className="tree-leaf-spacer" />
                    <span className="tree-node-icon"><FileText size={14} /></span>
                    <span className="tree-node-label">(誘몃텇瑜?</span>
                    <span className={`tree-count-badge ${(pathDataCountMap.get('(誘몃텇瑜?') || 0) > 0 ? 'has-data' : ''}`}>
                      {pathDataCountMap.get('(誘몃텇瑜?') || 0}
                    </span>
                  </div>
                </div>
              </div>

              {/* ?곗륫: ?좏깮???몃━ ?몃뱶???곌껐???곗씠?곕━?ㅽ듃 */}
              <div className="tree-right-list-panel">
                {selectedLinkedDomains.length > 0 ? (
                  /* ===== ?좏깮???몃뱶???곌껐??蹂듭닔 ?꾨찓?몃뱾????댄? 紐⑸줉 諛??쇱묠 議곗옉 ?붾㈃ ===== */
                  <div className="linked-domains-container">
                    {/* 蹂듭닔 ?꾨찓?몄씪 寃쎌슦 ?곷떒 ?ㅻ퉬寃뚯씠??& ?꾩껜 ?쇱튂湲??묎린 諛?*/}
                    {selectedLinkedDomains.length > 1 && (
                      <div className="linked-domains-top-bar">
                        <div className="linked-domains-top-title">
                          <Link2 size={14} className="tree-linked-icon" />
                          <span>?곌껐 ?꾨찓??紐⑸줉 ({selectedLinkedDomains.length}媛?</span>
                        </div>
                        <div className="linked-domains-top-actions">
                          {selectedLinkedDomains.map(d => {
                            const isExp = expandedDomainIds.has(d.id);
                            const count = getAtomsForDomain(d.id).filter(r => {
                              if (selectedParentInstanceId && r.data._parentInstanceId && r.data._parentInstanceId !== selectedParentInstanceId) return false;
                              if (selectedNode && r.data._treeNodeId) return r.data._treeNodeId === selectedNode.id;
                              return true;
                            }).length;
                            return (
                              <button
                                key={d.id}
                                type="button"
                                className={`linked-domain-tab-pill ${isExp ? 'active' : ''}`}
