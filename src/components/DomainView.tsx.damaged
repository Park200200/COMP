                                title={isExp ? `${d.name} ?묎린` : `${d.name} ?쇱튂湲?}
                              >
                                <span className="tab-icon">{d.icon || '?뱚'}</span>
                                <span className="tab-name">{d.name}</span>
                                <span className="tab-count">{count}</span>
                                {isExp ? <ChevronDown size={11} /> : <ChevronRight size={11} />}
                              </button>
                            );
                          })}
                          <button
                            type="button"
                            className="linked-domains-expand-toggle-btn"
                            onClick={() => {
                              if (expandedDomainIds.size === selectedLinkedDomains.length) {
                                setExpandedDomainIds(new Set());
                              } else {
                                setExpandedDomainIds(new Set(selectedLinkedDomains.map(d => d.id)));
                              }
                            }}
                          >
                            {expandedDomainIds.size === selectedLinkedDomains.length ? (
                              <>
                                <ChevronUp size={12} />
                                <span>紐⑤몢 ?묎린</span>
