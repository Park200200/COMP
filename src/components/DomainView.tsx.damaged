                  {/* 怨좎젙 ?몃뱶: (誘몃텇瑜? 蹂닿린 */}
                  <div
                    className={`master-tree-node-row static-node ${selectedNodePath === '(誘몃텇瑜?' ? 'selected' : ''}`}
