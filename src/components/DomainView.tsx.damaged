                        >
                          <div className="field-config-modal-header">
                            <div className="field-config-modal-title">

                              <div>
                                <h4>"{fieldConfigModalDomain.name}" 援ъ꽦?붿냼(?꾨뱶) ?ㅼ젙</h4>
                                <p>媛?援ъ꽦?붿냼???ъ슜?щ?(誘몄궗?????붾㈃?먯꽌 ?쒖쇅) 諛?蹂닿린/媛먯텛湲??붾툝?대┃ ???쒖떆)瑜?愿由ы빀?덈떎.</p>
                              </div>
                            </div>
                            <button
                              type="button"
                              className="modal-close-btn"
                              onClick={() => setFieldConfigModalDomain(null)}
                              title=""
                            >
                              <X size={16} />
                            </button>
                          </div>

                          <div className="field-config-modal-body">
                            <table className="field-config-table">
                              <thead>
                                <tr>
                                  <th style={{ width: '60%' }}>援ъ꽦?붿냼(?꾨뱶紐?</th>
                                  <th style={{ width: '40%', textAlign: 'center' }}>?ъ슜?щ? (?뚯씠釉??쒖떆)</th>
                                </tr>
                              </thead>
                              <tbody>
                                {getFieldsForDomain(fieldConfigModalDomain.id).filter(f => !compositePartNames.has(f.name)).map(f => {
                                  const cfg = getConstituentFieldConfig(fieldConfigModalDomain.id, f.name, selectedNode?.id);
                                  const isUnused = cfg.useStatus === '遺';

                                  return (
                                    <tr key={f.id} className={isUnused ? 'row-unused' : ''}>
