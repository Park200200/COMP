                        value={newRootLabel}
                        onChange={e => setNewRootLabel(e.target.value)}
                        onKeyDown={e => {
                          if (e.key === 'Enter') handleAddRootNode();
                          if (e.key === 'Escape') setShowAddRootInput(false);
                        }}
                        autoFocus
                      />
                      <button type="button" className="btn-confirm" onClick={handleAddRootNode}>異붽?</button>
                      <button type="button" className="btn-cancel" onClick={() => setShowAddRootInput(false)}>痍⑥냼</button>
                    </div>
                  )}

                  {/* 留덉뒪???몃━ ?몃뱶 ?뚮뜑 紐⑸줉 */}
                  {masterTreeData.length > 0 ? (
                    renderMasterTreeNodes(masterTreeData)
